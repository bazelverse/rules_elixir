load(
    "@bazel_skylib//rules:common_settings.bzl",
    "string_flag",
)

string_flag(
    name = "elixir_home",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

load("//private:mix_payloads.bzl", "mix_payloads")

# Empty by default: a repository with no NIFs and no Hex archive needs no payloads.
mix_payloads(
    name = "no_mix_payloads",
    visibility = ["//visibility:public"],
)

# Point this at your own mix_payloads target:
#     build --@rules_elixir//:mix_payloads=//build:mix_payloads
label_flag(
    name = "mix_payloads",
    build_setting_default = ":no_mix_payloads",
    visibility = ["//visibility:public"],
)
