load(
    "@bazel_skylib//rules:common_settings.bzl",
    "string_flag",
)

string_flag(
    name = "elixir_home",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# Repository-specific inputs every Mix compile stages -- see //private:mix_payloads.bzl.
# Optional: a repository with no NIFs and no Hex archive registers none.
toolchain_type(
    name = "mix_payloads_toolchain_type",
    visibility = ["//visibility:public"],
)

# protoc plus the protoc-gen-elixir plugin. The plugin is built from the protobuf Hex package,
# whose repository name only the consumer knows, so it is resolved rather than defaulted.
toolchain_type(
    name = "elixir_proto_toolchain_type",
    visibility = ["//visibility:public"],
)
